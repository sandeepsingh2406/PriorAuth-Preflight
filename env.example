# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.

# Your personal OpenAI API key (not a work key).
OPENAI_API_KEY=your-openai-api-key-here

# Model names your key can use. Use a small, inexpensive model for development
# and a stronger one for the final evaluation and demo. Check your OpenAI dashboard
# for the exact names available to you.
MODEL_DEV=your-small-model-name
MODEL_DEMO=your-stronger-model-name

# Set to true to use MODEL_DEMO instead of MODEL_DEV.
USE_DEMO_MODEL=false

# Where the audit log is written (git-ignored).
AUDIT_LOG_PATH=audit/runs.jsonl

# Optional: set to 1 to turn off OpenAI Agents SDK tracing. Tracing sends run data
# to the OpenAI platform, so use it with synthetic data only. Check the SDK docs for
# the current setting name before relying on this one.
# OPENAI_AGENTS_DISABLE_TRACING=1
